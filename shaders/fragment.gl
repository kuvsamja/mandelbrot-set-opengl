#version 420 core

in vec2 frag_uv;

uniform dvec2 camera_world_position;
uniform dvec2 camera_world_size;

out vec4 out_color;

dvec2 cx_add(dvec2 a, dvec2 b) {
    return dvec2(
        a.x + b.x,
        a.y + b.y
    );
}

dvec2 cx_sub(dvec2 a, dvec2 b) {
    return dvec2(
        a.x - b.x,
        a.y - b.y
    );
}

dvec2 cx_mul(dvec2 a, dvec2 b) {
    return dvec2(
        a.x*b.x - a.y*b.y,
        a.y*b.x + a.x*b.y
    );
}

double cx_abs_sq(dvec2 a) {
    return (a.x*a.x + a.y*a.y);
}

double z2pcDivergenceSpeed(dvec2 c, int max_iterations) {
    dvec2 z = dvec2(0.0, 0.0);
    for (int i = 0; i < max_iterations; i++) {
        z = cx_add(cx_mul(z, z), c);
        if (cx_abs_sq(z) > 4.0) {
            // length() has no dvec2 overload, so cast down to float
            // just for this smooth-coloring correction term.
            float len = length(vec2(z));
            return i + 1 - log2(log2(len));
        }
    }
    return -1.0;
}

vec4 iterationsToColor(double t) {
    if (t == 0.0) return vec4(0, 0, 0, 1);

    double hue = t * 360.0;
    double s = 1.0, v = 1.0;

    int h = int(hue / 60) % 6;
    double f = hue / 60 - int(hue / 60);
    double p = v * (1 - s);
    double q = v * (1 - f * s);
    double r = v * (1 - (1 - f) * s);

    switch (h) {
        case 0: return vec4(v, r, p, 1);
        case 1: return vec4(q, v, p, 1);
        case 2: return vec4(p, v, r, 1);
        case 3: return vec4(p, q, v, 1);
        case 4: return vec4(r, p, v, 1);
        case 5: return vec4(v, p, q, 1);
    }
    return vec4(0, 0, 0, 1);
}

void main() {
    dvec2 c = camera_world_position + dvec2(frag_uv) * camera_world_size;
    int max_iterations = int(100 * max(1.0, log2(3.5 / float(camera_world_size.x))));
    max_iterations = min(max_iterations, 2000);
    double iteration_count = z2pcDivergenceSpeed(c, max_iterations);

    if (iteration_count < 0) {
        out_color = vec4(0, 0, 0, 1);
    } else {
        double t = iteration_count / 100.0;
        out_color = iterationsToColor(t);
    }
}